<Window x:Class="VWIDE.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VWIDE"
        mc:Ignorable="d"
        Title="Window2" Height="475" Width="395">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="Gray">
            <MenuItem Header="_Configure New Binary" Click="newBinary_Click">
                <Label Content="Label"/>
            </MenuItem>
            <MenuItem Header="_Exit" Click="exit_Click"></MenuItem>
        </Menu>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="cBLayout" Margin="10"/>
        </ScrollViewer>
    </Grid>
</Window>
