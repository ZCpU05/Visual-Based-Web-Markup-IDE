<Window x:Class="VWIDE.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VWIDE"
        mc:Ignorable="d"
        Title="Window1" Height="440" Width="378">
    <Grid>


        <Rectangle HorizontalAlignment="Center" Height="51" Stroke="Black" VerticalAlignment="Top" Width="378" Fill="Gray"/>
        <Rectangle HorizontalAlignment="Center" Height="51" Stroke="Black" VerticalAlignment="Top" Width="378" Fill="Gray" Margin="0,52,0,0"/>
        <Rectangle HorizontalAlignment="Left" Height="51" Stroke="Black" VerticalAlignment="Top" Width="30" Fill="Black" Margin="46,52,0,0"/>
        <Rectangle HorizontalAlignment="Left" Height="51" Stroke="Black" VerticalAlignment="Top" Width="30" Fill="Black" Margin="46,0,0,0"/>
        <Rectangle HorizontalAlignment="Left" Height="51" Stroke="Black" VerticalAlignment="Top" Width="30" Fill="Black" Margin="240,52,0,0"/>
        <Rectangle HorizontalAlignment="Left" Height="51" Stroke="Black" VerticalAlignment="Top" Width="30" Fill="Black" Margin="240,0,0,0"/>

        <Label Content="Python" Margin="100,14,14,334"/>
        <Label Content="Node.JS" Margin="100,64,14,308"/>

        <Button Content="Install" Margin="286,14,14,365" Uid="0" Click="download_Click" x:Name="pythonIN"/>
        <Button Content="Install" Margin="286,64,14,308" Uid="1" Click="download_Click" x:Name="nodeJSIN"/>
        <Button Content="Uninstall" Margin="286,14,14,365" Uid="0" Click="uninstall_Click" x:Name="pythonUN"/>
        <Button Content="Uninstall" Margin="286,64,14,308" Uid="1" Click="uninstall_Click" x:Name="nodeJSUN"/>
        <Image Margin="1,-4,321,345" Source="/python_Logo.png" RenderTransformOrigin="0.315,1.123"/>
        <Image Margin="1,48,321,290" Source="/node_logo.png"/>
    </Grid>
</Window>
